    "@google/generative-ai": "^0.24.1",
    "@mozilla/readability": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "jsdom": "^29.1.1",
    "mongoose": "^8.4.1",
    "youtube-caption-extractor": "^1.10.2",
    "youtube-captions-scraper": "^2.0.3",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
